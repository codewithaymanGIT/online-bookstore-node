<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= book.title %> — Marginalia</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-left">
            <a href="/" class="logo">Marginalia</a>
            <span class="student-credit">Mohammed Ayman Siddiqui · CS-H · Roll 13 · PRN 12414007</span>
        </div>
        <div class="nav-links">
            <a href="/catalogue">Catalogue</a>
            <a href="/cart" class="cart-link">Cart<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
            <% if (user) { %>
                <a href="/orders" class="btn-text">My Orders</a>
                <span class="nav-user">Hi, <%= user.name.split(' ')[0] %></span>
                <a href="/logout" class="btn-text">Log out</a>
            <% } else { %>
                <a href="/login" class="btn-text">Log in</a>
                <a href="/register" class="btn-primary-small">Sign up</a>
            <% } %>
        </div>
    </nav>

    <section class="book-detail-layout">
        <img src="<%= book.cover_url %>" alt="<%= book.title %>" class="book-detail-cover" />
        <div class="book-detail-info">
            <h1><%= book.title %></h1>
            <p class="book-detail-author">by <%= book.author %></p>
            <div class="book-detail-rating">★ <%= book.rating %></div>
            <p class="book-detail-price">₹<%= book.price %></p>

            <p class="book-detail-desc"><%= book.description %></p>

            <div class="curator-note">
                <strong>Why we recommend it:</strong>
                <p><%= book.curator_note %></p>
            </div>

            <form method="POST" action="/cart/add/<%= book.id %>" class="add-to-cart-form">
                <button type="submit" class="btn-primary">Add to Cart</button>
            </form>

            <p class="stock-note"><%= book.stock %> copies in stock</p>
        </div>
    </section>

    <footer class="footer">
        <p>Marginalia — curated technical reading, chosen with care.</p>
    </footer>
</body>
</html>